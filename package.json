{
  "name": "css-minify-tests",
  "version": "0.1.0",
  "type": "module",
  "description": "Correctness tests for CSS minifiers",
  "scripts": {
    "start": "http-server",
    "lint": "npm run lint:md && npm run lint:js",
    "fix": "npm run lint:md:fix && npm run lint:js:fix",
    "lint:md": "markdownlint -i \"./node_modules/**/*\" --config ./.markdown-lint.yml ./**/*.md",
    "lint:js": "eslint *.js lib scripts",
    "lint:md:fix": "npm run lint:md -- --fix",
    "lint:js:fix": "npm run lint:js -- --fix",
    "test": "cross-env NO_COLOR=1 node ./run-tests.js",
    "test:debug": "cross-env DEBUG=true node ./run-tests.js",
    "new-test": "node ./scripts/create-test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@thejaredwilcurt/csslop": "^0.0.35",
    "autoprefixer": "^10.5.5",
    "clean-css": "^5.3.3",
    "cross-env": "^10.1.0",
    "csskit": "^0.0.31",
    "cssnano": "^9.0.2",
    "cssnano-preset-advanced": "^9.0.2",
    "csso": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-jsdoc": "^2.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.5",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "lightningcss": "^1.33.0",
    "markdownlint-cli": "^0.49.1",
    "marked": "^18.0.11",
    "postcss": "^8.5.28",
    "pretty-ms": "^9.3.1",
    "real-world-css-libraries": "^1.0.8",
    "sass": "^1.104.0",
    "shiki": "^4.4.3",
    "tjw-markdownlint-rules": "^1.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2"
    }
  }
}
